# ───────────────────────────────────────────────────────────────
# Brevo (transactional email + contacts) — SERVER-SIDE ONLY.
# Never prefix these with VITE_ (that would expose them to the browser).
# ───────────────────────────────────────────────────────────────

# Your Brevo API key (Brevo dashboard → SMTP & API → API Keys)
BREVO_API_KEY=

# Verified sender in Brevo (Senders, Domains & Dedicated IPs → Senders)
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Gerousia Care Services

# Inbox that receives form notifications
BUSINESS_NOTIFICATION_EMAIL=

# Optional: Brevo contact list id for newsletter subscribers
BREVO_NEWSLETTER_LIST_ID=

# Optional: restrict CORS to this origin (e.g. https://gerousiacareservices.com)
# Leave blank for same-origin requests on Vercel.
ALLOWED_ORIGIN=
